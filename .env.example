# Required for Gemini-backed Q&A, quiz, summary and learning path.
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Current stable model. Change this without editing Python code.
GEMINI_MODEL=gemini-3.8-flash

# Explanation backend: local (LaMini-Flan-T5) or gemini.
EXPLANATION_BACKEND=local
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M

# Request safety/size limit.
MAX_INPUT_CHARS=30000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
